DOMAIN=:80
APP_ENV=production
APP_SECRET=replace-with-64-random-characters
JWT_SECRET=replace-with-another-64-random-characters
ADMIN_API_TOKEN=replace-with-64-random-characters
ADMIN_CORS_ORIGINS=http://127.0.0.1,http://localhost,http://107.172.138.14

POSTGRES_DB=novelforge
POSTGRES_USER=novelforge
POSTGRES_PASSWORD=replace-with-strong-password

# Reachable from containers. Prefer host gateway or external network DNS.
# Example when new-api is on host port 3000:
# PRIMARY_BASE_URL=http://172.17.0.1:3000/v1
# Or when new-api is attached to novelforge_internal:
PRIMARY_BASE_URL=http://new-api:3000/v1
PRIMARY_API_KEY=replace-with-real-key
FALLBACK_BASE_URL=
FALLBACK_API_KEY=

PLANNER_MODEL=deepseek-v4-flash
WRITER_MODEL=stepfun-ai/step-3.7-flash
REVIEW_MODEL=deepseek-v4-flash
QUERY_MODEL=deepseek-v4-flash
RANKER_MODEL=deepseek-v4-flash

GLOBAL_LLM_CONCURRENCY=1
ARQ_MAX_JOBS=1
ARQ_JOB_TIMEOUT=14400
LOG_LEVEL=INFO
RAW_PROVIDER_RETENTION_DAYS=30
