#!/usr/bin/env bash
# Root-owned, argument-validating NovelForge release controller.
#
# Deploy atomicity contract (ops rework round 3):
#   candidate <sha>  - fetches, verifies, prepares the release, then builds
#                      and gates EVERYTHING under a per-attempt isolated
#                      compose project (project name = base + full attempt
#                      UUID; own images/volumes/network via the attempt env
#                      file, throwaway databases, production data mounted
#                      read-only or not at all).
#                      A 0600 root-runtime file freezes $SHARED/.env exactly;
#                      a second non-secret override supplies RELEASE_TAG,
#                      CANDIDATE_ATTEMPT and the service env-file path, so a
#                      mid-attempt rotation cannot mix runtime inputs.
#                      The sha's envelope is invalidated to state=running
#                      BEFORE any build work and only published state=passed
#                      after every gate (including a production-snapshot
#                      restore+migrate check) succeeded and image digests
#                      were recorded. Any other exit leaves state=failed.
#   deploy <sha>     - accepts ONLY a strictly-parsed state=passed envelope
#                      bound to the exact sha with a matching current shared
#                      env hash; publishes the release artifact tags from the
#                      verified candidate digests; then backup (compose exec
#                      only) -> one-off migration -> symlink switch -> health
#                      -> automatic rollback.
#   status           - reports app release provenance, infra image versions,
#                      missing/unexpected services and mixed_release.
set -Eeuo pipefail
umask 027

ROOT=${NOVELFORGE_ROOT:-/srv/novelforge}
MIRROR="$ROOT/repo.git"
RELEASES="$ROOT/releases"
SHARED="$ROOT/shared"
CURRENT="$ROOT/current"
CONF=${NOVELFORGE_CONF:-/etc/novelforge-ops.conf}
LOCK_FILE=${NOVELFORGE_LOCK:-/run/lock/novelforge-release.lock}
CANDIDATE_PROJECT_BASE=${NOVELFORGE_CANDIDATE_PROJECT:-novelforge-candidate}
CANDIDATES_DIR="$SHARED/candidates"
CANDIDATE_RUNTIME_DIR=${NOVELFORGE_CANDIDATE_RUNTIME_DIR:-/run/novelforge-candidate}
RELEASE_TAGS_DIR="$SHARED/release-tags"
CANDIDATE_MAX_AGE_SECONDS=${CANDIDATE_MAX_AGE_SECONDS:-86400}
PACK=production_packs/zhutian_hongyanlu/pack.json
EXPECTED_SERVICES="api web worker postgres redis"
OPS_TARGET=${NOVELFORGE_OPS_TARGET:-/usr/local/sbin/novelforge-release}
OPS_WRAPPER_TARGET=${NOVELFORGE_OPS_WRAPPER_TARGET:-/usr/local/sbin/novelforge-ops}

exec 9>"$LOCK_FILE"
flock -w 5 9 || { echo '{"ok":false,"error":"release_busy"}'; exit 75; }

[ -r "$CONF" ] || { echo "missing $CONF" >&2; exit 78; }
# shellcheck source=/dev/null
source "$CONF"
: "${REPOSITORY_URL:?missing REPOSITORY_URL}"
DEPLOY_BRANCH=${DEPLOY_BRANCH:-main}
HEALTH_URL=${HEALTH_URL:-http://127.0.0.1/health/ready}

die() { echo "$2" >&2; exit "$1"; }

# ── envelope: strict, fail-closed parser (acceptance P0-C) ──────────────────
# Grammar: one key=value per line; the nine keys written by write_envelope()
# occur exactly once and are format checked. Passed envelopes additionally
# require successful migration evidence and all three application digests.
# Parsed values are exported as ENV_* variables on success; any violation
# exits 71 before backup, migration, tag publication or service mutation.

envelope_path() { printf '%s/%s.envelope\n' "$CANDIDATES_DIR" "$1"; }

write_envelope() { # $1=sha $2=attempt_id $3=state $4=hash of the env actually tested
  local sha=$1 attempt=$2 state=$3 tested_env_hash=$4 file
  file=$(envelope_path "$sha")
  install -d -m 0750 "$CANDIDATES_DIR"
  {
    printf 'sha=%s\n' "$sha"
    printf 'attempt_id=%s\n' "$attempt"
    printf 'created=%s\n' "$(date -u +%s)"
    printf 'state=%s\n' "$state"
    printf 'env_hash=%s\n' "$tested_env_hash"
    printf 'migration_fresh=%s\n' "${ENVELOPE_MIGRATION_FRESH:-pending}"
    printf 'migration_snapshot=%s\n' "${ENVELOPE_MIGRATION_SNAPSHOT:-pending}"
    printf 'migration_snapshot_dump=%s\n' "${ENVELOPE_MIGRATION_SNAPSHOT_DUMP:-}"
    printf 'image_digests=%s\n' "${ENVELOPE_IMAGE_DIGESTS:-}"
  } >"$file.tmp"
  chmod 0640 "$file.tmp"
  mv -f "$file.tmp" "$file"
}

env_file_hash() {
  sha256sum "$SHARED/.env" | cut -d' ' -f1
}

is_hex() { # $1=length $2=value
  [[ $2 =~ ^[0-9a-f]{$1}$ ]]
}

parse_envelope() { # $1=sha -> exits 71 on any violation
  local sha=$1 file line key value
  file=$(envelope_path "$sha")
  [ -f "$file" ] \
    || die 71 "candidate gate result missing for $sha; run 'candidate $sha' first"

  ENV_SHA=""; ENV_ATTEMPT_ID=""; ENV_CREATED=""; ENV_STATE=""
  ENV_HASH=""; ENV_MIGRATION_FRESH=""; ENV_MIGRATION_SNAPSHOT=""
  ENV_MIGRATION_SNAPSHOT_DUMP=""
  ENV_DIGEST_API=""; ENV_DIGEST_WORKER=""; ENV_DIGEST_WEB=""
  declare -A envelope_seen=()

  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || continue
    case "$line" in
      sha=*|attempt_id=*|created=*|state=*|env_hash=*|migration_fresh=*|migration_snapshot=*|migration_snapshot_dump=*|image_digests=*) ;;
      *) die 71 "candidate envelope for $sha has an unknown or malformed line: $line" ;;
    esac
    key=${line%%=*}
    value=${line#*=}
    [ -z "${envelope_seen[$key]+x}" ] \
      || die 71 "candidate envelope for $sha: duplicate $key field"
    envelope_seen[$key]=1
    case "$key" in
      sha)
        is_hex 40 "$value" || die 71 "candidate envelope for $sha: invalid sha format"
        ENV_SHA=$value
        ;;
      attempt_id)
        [[ $value =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] \
          || die 71 "candidate envelope for $sha: invalid attempt_id"
        ENV_ATTEMPT_ID=$value
        ;;
      created)
        [[ $value =~ ^[1-9][0-9]{9,11}$ ]] \
          || die 71 "candidate envelope for $sha: non-numeric created"
        ENV_CREATED=$value
        ;;
      state)
        case "$value" in
          running|failed|passed) ;;
          *) die 71 "candidate envelope for $sha: invalid state '$value'" ;;
        esac
        ENV_STATE=$value
        ;;
      env_hash)
        is_hex 64 "$value" || die 71 "candidate envelope for $sha: invalid env_hash"
        ENV_HASH=$value
        ;;
      migration_fresh)
        case "$value" in pending|passed|failed) ;; *) die 71 "candidate envelope for $sha: invalid migration_fresh" ;; esac
        ENV_MIGRATION_FRESH=$value
        ;;
      migration_snapshot)
        case "$value" in pending|passed|failed|skipped) ;; *) die 71 "candidate envelope for $sha: invalid migration_snapshot" ;; esac
        ENV_MIGRATION_SNAPSHOT=$value
        ;;
      migration_snapshot_dump)
        [[ -z $value || $value =~ ^[A-Za-z0-9._-]{1,255}$ ]] \
          || die 71 "candidate envelope for $sha: invalid migration_snapshot_dump"
        ENV_MIGRATION_SNAPSHOT_DUMP=$value
        ;;
      image_digests)
        [ -z "$value" ] && continue
        local pair svc id
        local IFS='|'
        for pair in $value; do
          svc=${pair%%:*}
          id=${pair#*:}
          case "$svc" in
            api|worker|web) ;;
            *) die 71 "candidate envelope for $sha: unexpected image service '$svc'" ;;
          esac
          [[ $id =~ ^sha256:[0-9a-f]{64}$ ]] \
            || die 71 "candidate envelope for $sha: invalid digest for $svc"
          case "$svc" in
            api)
              [ -z "$ENV_DIGEST_API" ] || die 71 "candidate envelope for $sha: duplicate api digest"
              ENV_DIGEST_API=$id
              ;;
            worker)
              [ -z "$ENV_DIGEST_WORKER" ] || die 71 "candidate envelope for $sha: duplicate worker digest"
              ENV_DIGEST_WORKER=$id
              ;;
            web)
              [ -z "$ENV_DIGEST_WEB" ] || die 71 "candidate envelope for $sha: duplicate web digest"
              ENV_DIGEST_WEB=$id
              ;;
          esac
        done
        [ -n "$ENV_DIGEST_API" ] && [ -n "$ENV_DIGEST_WORKER" ] && [ -n "$ENV_DIGEST_WEB" ] \
          || die 71 "candidate envelope for $sha: image_digests must cover api, worker and web"
        ;;
    esac
  done <"$file"

  local required_key
  for required_key in sha attempt_id created state env_hash migration_fresh migration_snapshot migration_snapshot_dump image_digests; do
    [ -n "${envelope_seen[$required_key]+x}" ] \
      || die 71 "candidate envelope for $sha is missing $required_key"
  done
  [ "$ENV_SHA" = "$sha" ] \
    || die 71 "candidate envelope sha mismatch (envelope is for '$ENV_SHA'); re-run 'candidate $sha'"
  if [ "$ENV_STATE" = "passed" ]; then
    [ "$ENV_MIGRATION_FRESH" = "passed" ] \
      || die 71 "candidate envelope for $sha lacks a passed fresh migration"
    case "$ENV_MIGRATION_SNAPSHOT" in
      passed)
        [ -n "$ENV_MIGRATION_SNAPSHOT_DUMP" ] \
          || die 71 "candidate envelope for $sha: passed snapshot has no dump evidence"
        ;;
      skipped)
        [ -z "$ENV_MIGRATION_SNAPSHOT_DUMP" ] \
          || die 71 "candidate envelope for $sha: skipped snapshot unexpectedly names a dump"
        ;;
      *) die 71 "candidate envelope for $sha lacks valid snapshot migration evidence" ;;
    esac
    [ -n "$ENV_DIGEST_API" ] && [ -n "$ENV_DIGEST_WORKER" ] && [ -n "$ENV_DIGEST_WEB" ] \
      || die 71 "candidate envelope for $sha: image_digests must cover api, worker and web"
  fi
  return 0
}

# ── compose wrappers ────────────────────────────────────────────────────────

_compose_cli() {
  # Docker CLI with the compose plugin (production) or the standalone
  # docker-compose binary (dev/test machines without the plugin).
  if command -v docker >/dev/null 2>&1; then
    docker compose "$@"
  else
    docker-compose "$@"
  fi
}

compose() {
  # Production compose project. Interpolation: shared .env (single source of
  # runtime secrets, never cached) + release-tags/<sha>.env (RELEASE_TAG only).
  local release=$1
  shift
  _compose_cli \
    --env-file "$SHARED/.env" \
    --env-file "$RELEASE_TAGS_DIR/${release##*/}.env" \
    --project-directory "$release/deploy" \
    -f "$release/deploy/docker-compose.yml" "$@"
}

attempt_env_file() { printf '%s/%s.shared.env\n' "$CANDIDATE_RUNTIME_DIR" "$1"; }
attempt_override_file() { printf '%s/%s.compose.env\n' "$CANDIDATE_RUNTIME_DIR" "$1"; }

create_attempt_env() { # $1=attempt: frozen secret snapshot + non-secret compose overrides
  local attempt=$1 shared_file override_file
  shared_file=$(attempt_env_file "$attempt")
  override_file=$(attempt_override_file "$attempt")
  install -d -m 0700 "$CANDIDATE_RUNTIME_DIR"
  install -m 0600 "$SHARED/.env" "$shared_file.tmp"
  mv -f "$shared_file.tmp" "$shared_file"
  {
    printf 'RELEASE_TAG=candidate-%s\n' "$attempt"
    printf 'CANDIDATE_ATTEMPT=%s\n' "$attempt"
    printf 'CANDIDATE_ENV_FILE=%s\n' "$shared_file"
  } >"$override_file.tmp"
  chmod 0600 "$override_file.tmp"
  mv -f "$override_file.tmp" "$override_file"
}

compose_candidate() {
  # Per-attempt isolated project: name carries the FULL validated attempt id.
  # The ONLY env source is the frozen 0600 attempt snapshot taken at candidate
  # start, so a mid-attempt secret rotation cannot mix environments (§9.1).
  local release=$1 attempt=$2
  shift 2
  _compose_cli \
    --env-file "$(attempt_env_file "$attempt")" \
    --env-file "$(attempt_override_file "$attempt")" \
    --project-directory "$release/deploy" \
    -f "$release/deploy/docker-compose.yml" \
    -f "$release/deploy/docker-compose.candidate.yml" \
    -p "${CANDIDATE_PROJECT_BASE}-${attempt}" "$@"
}

write_release_tag_file() { # $1=release path
  local sha=${1##*/}
  install -d -m 0750 "$RELEASE_TAGS_DIR"
  if [ ! -f "$RELEASE_TAGS_DIR/$sha.env" ]; then
    printf 'RELEASE_TAG=%s\n' "$sha" >"$RELEASE_TAGS_DIR/$sha.env.tmp"
    chmod 0640 "$RELEASE_TAGS_DIR/$sha.env.tmp"
    mv -f "$RELEASE_TAGS_DIR/$sha.env.tmp" "$RELEASE_TAGS_DIR/$sha.env"
  fi
}

# ── shared state helpers ────────────────────────────────────────────────────

current_release() {
  local release
  if [ -L "$CURRENT" ]; then
    release=$(readlink -f "$CURRENT" 2>/dev/null || true)
    if [[ $release =~ ^${RELEASES}/[0-9a-f]{40}$ ]] \
      && [ -f "$release/deploy/docker-compose.yml" ]; then
      printf '%s\n' "$release"
    fi
  fi
  return 0
}

current_sha() {
  local release
  release=$(current_release)
  [ -n "$release" ] && basename "$release" || true
}

healthy() {
  curl --fail --silent --show-error --max-time 8 "$HEALTH_URL" \
    | grep -Eq '"status"[[:space:]]*:[[:space:]]*"ready"'
}

wait_healthy() {
  local attempt
  for attempt in $(seq 1 "${HEALTH_CHECK_ATTEMPTS:-30}"); do
    healthy && return 0
    sleep "${HEALTH_CHECK_INTERVAL:-2}"
  done
  return 1
}

wait_postgres() {
  # $1: compose function name, $2: release, $3: attempt id (candidate only).
  local compose_fn=$1 release=$2 attempt=${3:-} count=0
  while [ "$count" -lt "${PG_WAIT_ATTEMPTS:-30}" ]; do
    # shellcheck disable=SC2016 # variables expand inside the postgres container
    "$compose_fn" "$release" "$attempt" exec -T postgres sh -ec \
      'pg_isready --username="$POSTGRES_USER" --dbname="$POSTGRES_DB"' \
      >/dev/null 2>&1 && return 0
    count=$((count + 1))
    sleep "${PG_WAIT_INTERVAL:-2}"
  done
  return 1
}

app_image_digest() { # $1=tag -> image id on stdout, rc!=0 when absent
  docker image inspect --format '{{.Id}}' "$1"
}

# ── backup / git / prepare ──────────────────────────────────────────────────

backup_database() {
  # Backup via `compose exec` ONLY: never starts or recreates a container. If
  # production postgres is not running, deploy aborts (self-heal first).
  local release=$1 target_sha=$2 stamp destination temporary
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  destination="$SHARED/data/backups/pre-${target_sha}-${stamp}.dump"
  temporary="${destination}.tmp"
  # shellcheck disable=SC2016 # variables expand inside the postgres container
  if ! compose "$release" exec -T postgres sh -ec \
    'export PGPASSWORD="$POSTGRES_PASSWORD"; exec pg_dump --format=custom --no-owner --no-acl --username="$POSTGRES_USER" --dbname="$POSTGRES_DB"' \
    >"$temporary"; then
    rm -f "$temporary"
    echo "database backup failed (is postgres running?); migration was not started" >&2
    return 1
  fi
  if [ ! -s "$temporary" ]; then
    rm -f "$temporary"
    echo "database backup is empty; migration was not started" >&2
    return 1
  fi
  chmod 0640 "$temporary"
  mv -f "$temporary" "$destination"
  echo "database backup: $destination" >&2
  printf '%s\n' "$destination"
}

fetch_main() {
  if [ ! -d "$MIRROR" ]; then
    git clone --mirror "$REPOSITORY_URL" "$MIRROR"
  fi
  git --git-dir="$MIRROR" remote set-url origin "$REPOSITORY_URL"
  git --git-dir="$MIRROR" fetch --prune origin "+refs/heads/$DEPLOY_BRANCH:refs/remotes/origin/$DEPLOY_BRANCH"
}

validate_sha() {
  local sha=$1
  [[ $sha =~ ^[0-9a-f]{40}$ ]] || die 64 "invalid sha"
  git --git-dir="$MIRROR" rev-parse --verify "$sha^{commit}" >/dev/null
  git --git-dir="$MIRROR" merge-base --is-ancestor "$sha" "refs/remotes/origin/$DEPLOY_BRANCH" \
    || die 65 "sha is not on origin/$DEPLOY_BRANCH"
}

prepare_release() {
  local sha=$1
  local release="$RELEASES/$sha"
  if [ ! -f "$release/.git" ]; then
    [ ! -e "$release" ] || die 73 "invalid pre-existing release path"
    git --git-dir="$MIRROR" worktree add --detach "$release" "$sha" >&2
  fi
  [ -f "$SHARED/.env" ] || die 78 "missing $SHARED/.env"
  install -d -m 0750 -o 10001 -g 10001 \
    "$SHARED/data/books" "$SHARED/data/exports" \
    "$SHARED/data/references" "$SHARED/data/imports"
  install -d -m 0750 -o root -g root "$SHARED/data/backups"
  rm -f "$release/deploy/.env"
  ln -s "$SHARED/.env" "$release/deploy/.env"
  write_release_tag_file "$release"
  if [ -e "$release/data" ] && [ ! -L "$release/data" ]; then
    die 73 "release contains a non-symlink data path"
  fi
  ln -sfn "$SHARED/data" "$release/data"
  printf '%s\n' "$release"
}

switch_to() {
  local release=$1
  local managed legacy stamp
  managed=$(current_release)
  if { [ -e "$CURRENT" ] || [ -L "$CURRENT" ]; } && [ -z "$managed" ]; then
    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    install -d -m 0750 -o root -g root "$ROOT/legacy"
    legacy="$ROOT/legacy/current-$stamp"
    [ ! -e "$legacy" ] && [ ! -L "$legacy" ] \
      || die 73 "legacy archive path already exists: $legacy"
    mv -T "$CURRENT" "$legacy"
    echo "legacy current archived: $legacy" >&2
  fi
  ln -sfn "$release" "$CURRENT.next"
  mv -Tf "$CURRENT.next" "$CURRENT"
}

install_release_controller() {
  local release=$1
  local stage_release stage_wrapper backup_release backup_wrapper
  local source_release_hash source_wrapper_hash after_release after_wrapper
  local had_release=false had_wrapper=false switched=false

  install -d -m 0755 "$(dirname "$OPS_TARGET")" "$(dirname "$OPS_WRAPPER_TARGET")"
  stage_release=$(mktemp "$OPS_TARGET.new.XXXXXX")
  stage_wrapper=$(mktemp "$OPS_WRAPPER_TARGET.new.XXXXXX")
  backup_release=$(mktemp "$OPS_TARGET.previous.XXXXXX")
  backup_wrapper=$(mktemp "$OPS_WRAPPER_TARGET.previous.XXXXXX")

  install -o root -g root -m 0755 \
    "$release/deploy/ops/novelforge-release" "$stage_release"
  install -o root -g root -m 0755 \
    "$release/deploy/ops/novelforge-ops" "$stage_wrapper"
  source_release_hash=$(sha256sum "$release/deploy/ops/novelforge-release" | cut -d' ' -f1)
  source_wrapper_hash=$(sha256sum "$release/deploy/ops/novelforge-ops" | cut -d' ' -f1)
  if [ "$(sha256sum "$stage_release" | cut -d' ' -f1)" != "$source_release_hash" ] \
    || [ "$(sha256sum "$stage_wrapper" | cut -d' ' -f1)" != "$source_wrapper_hash" ]; then
    rm -f "$stage_release" "$stage_wrapper" "$backup_release" "$backup_wrapper"
    die 70 "staged controller pair hash mismatch"
  fi

  if [ -f "$OPS_TARGET" ]; then cp -p "$OPS_TARGET" "$backup_release"; had_release=true; fi
  if [ -f "$OPS_WRAPPER_TARGET" ]; then cp -p "$OPS_WRAPPER_TARGET" "$backup_wrapper"; had_wrapper=true; fi

  if mv -f "$stage_release" "$OPS_TARGET" && mv -f "$stage_wrapper" "$OPS_WRAPPER_TARGET"; then
    after_release=$(sha256sum "$OPS_TARGET" | cut -d' ' -f1)
    after_wrapper=$(sha256sum "$OPS_WRAPPER_TARGET" | cut -d' ' -f1)
    if [ "$after_release" = "$source_release_hash" ] \
      && [ "$after_wrapper" = "$source_wrapper_hash" ]; then
      switched=true
    fi
  fi

  if [ "$switched" != "true" ]; then
    if [ "$had_release" = "true" ]; then mv -f "$backup_release" "$OPS_TARGET"; else rm -f "$OPS_TARGET"; fi
    if [ "$had_wrapper" = "true" ]; then mv -f "$backup_wrapper" "$OPS_WRAPPER_TARGET"; else rm -f "$OPS_WRAPPER_TARGET"; fi
    rm -f "$stage_release" "$stage_wrapper" "$backup_release" "$backup_wrapper"
    die 70 "controller pair install failed and was rolled back"
  fi
  rm -f "$stage_release" "$stage_wrapper" "$backup_release" "$backup_wrapper"
}

# ── candidate gate ──────────────────────────────────────────────────────────

candidate_sha() {
  local sha=$1 release attempt raw_dir
  local validate_rc=0 qualify_rc=0 snapshot_restore_rc=0 snapshot_migrate_rc=0
  local snapshot_state=skipped digests="" snapshot_dump="" candidate_env_hash

  fetch_main
  validate_sha "$sha"
  release=$(prepare_release "$sha")

  attempt=$(cat /proc/sys/kernel/random/uuid 2>/dev/null \
    || printf '%s-%s' "$(date -u +%s)" "$$")
  [[ $attempt =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] \
    || die 70 "could not generate a valid candidate attempt id"

  # P0-1: invalidate any previous success for this sha BEFORE touching
  # anything. From this moment deploy refuses (state=running).
  ENVELOPE_MIGRATION_FRESH=pending
  ENVELOPE_MIGRATION_SNAPSHOT=pending
  ENVELOPE_MIGRATION_SNAPSHOT_DUMP=""
  ENVELOPE_IMAGE_DIGESTS=""
  candidate_env_hash=$(env_file_hash)
  write_envelope "$sha" "$attempt" running "$candidate_env_hash"

  CANDIDATE_RELEASE=$release
  CANDIDATE_ATTEMPT=$attempt
  CANDIDATE_SHA=$sha
  CANDIDATE_ENV_HASH=$candidate_env_hash
  CANDIDATE_PUBLISHED=false
  candidate_cleanup() {
    if [ -n "${CANDIDATE_RELEASE:-}" ] && [ -n "${CANDIDATE_ATTEMPT:-}" ] \
      && [ -f "$(attempt_env_file "$CANDIDATE_ATTEMPT")" ] \
      && [ -f "$(attempt_override_file "$CANDIDATE_ATTEMPT")" ]; then
      compose_candidate "$CANDIDATE_RELEASE" "$CANDIDATE_ATTEMPT" \
        down -v --remove-orphans >/dev/null 2>&1 || true
    fi
    # Frozen secret material lives only in the root-only runtime directory.
    rm -f "$(attempt_env_file "${CANDIDATE_ATTEMPT:-}")" \
      "$(attempt_override_file "${CANDIDATE_ATTEMPT:-}")"
    if [ "${CANDIDATE_PUBLISHED:-false}" != "true" ]; then
      write_envelope "${CANDIDATE_SHA:-}" "${CANDIDATE_ATTEMPT:-}" failed \
        "${CANDIDATE_ENV_HASH:-$candidate_env_hash}" || true
    fi
  }
  candidate_cleanup_on_exit() { candidate_cleanup; }
  trap candidate_cleanup_on_exit EXIT

  # P0-A / §9.1: frozen 0600 secret snapshot plus a separate compose override.
  # Both interpolation and service env_file consumption use the snapshot; a
  # mid-attempt rotation cannot mix environments, and the network/volume names
  # receive the real attempt id rather than "unset".
  create_attempt_env "$attempt"
  candidate_env_hash=$(sha256sum "$(attempt_env_file "$attempt")" | cut -d' ' -f1)
  CANDIDATE_ENV_HASH=$candidate_env_hash
  # Rewrite running with the hash of the exact frozen bytes that every gate
  # will consume. Later writes retain this hash even if shared .env rotates.
  write_envelope "$sha" "$attempt" running "$candidate_env_hash"

  # Validate the exact candidate merge and frozen env inputs, not production's
  # compose view.
  compose_candidate "$release" "$attempt" config --quiet

  raw_dir=$(mktemp -d "$CANDIDATES_DIR/$attempt.raw.XXXXXX")

  # Build all five images. App images carry the per-attempt tag
  # novelforge-<svc>:candidate-<attempt> (from the attempt env file), so a
  # failed candidate can never re-point the release tags of the currently
  # deployed sha (§9.2).
  compose_candidate "$release" "$attempt" build postgres redis api worker web

  # Isolated throwaway database (per-attempt volumes and network).
  compose_candidate "$release" "$attempt" up -d postgres redis
  wait_postgres compose_candidate "$release" "$attempt" \
    || die 70 "candidate postgres did not become ready"

  # 1) fresh-database migration.
  compose_candidate "$release" "$attempt" run --rm --no-deps api alembic upgrade head
  ENVELOPE_MIGRATION_FRESH=passed

  # 2) production-snapshot migration when a backup exists: stream the newest
  #    dump through STDIN into the RUNNING candidate postgres (exec, not a
  #    second container mounting the same PGDATA), then migrate the restored
  #    snapshot with the candidate api image. Reported separately (§9.3).
  local dump
  dump=$(find "$SHARED/data/backups" -maxdepth 1 -type f -name '*.dump' \
    -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -1 | cut -d' ' -f2- || true)
  if [ -n "$dump" ]; then
    snapshot_dump=$(basename "$dump")
    # shellcheck disable=SC2016 # variables expand inside the postgres container
    compose_candidate "$release" "$attempt" exec -T postgres sh -ec '
      export PGPASSWORD="$POSTGRES_PASSWORD"
      dropdb --if-exists --username="$POSTGRES_USER" snapshot_check
      createdb --username="$POSTGRES_USER" snapshot_check
      exec pg_restore --no-owner --no-acl --username="$POSTGRES_USER" --dbname=snapshot_check
    ' <"$dump" || snapshot_restore_rc=1
    if [ "$snapshot_restore_rc" -eq 0 ]; then
      compose_candidate "$release" "$attempt" run --rm --no-deps \
        api python -c 'import os, subprocess; from urllib.parse import quote; user=quote(os.environ["POSTGRES_USER"], safe=""); password=quote(os.environ["POSTGRES_PASSWORD"], safe=""); os.environ["DATABASE_URL"]=f"postgresql+asyncpg://{user}:{password}@postgres:5432/snapshot_check"; raise SystemExit(subprocess.call(["alembic", "upgrade", "head"]))' \
        || snapshot_migrate_rc=1
    fi
    if [ "$snapshot_restore_rc" -eq 0 ] && [ "$snapshot_migrate_rc" -eq 0 ]; then
      snapshot_state=passed
    else
      snapshot_state=failed
    fi
  else
    snapshot_state=skipped
  fi
  ENVELOPE_MIGRATION_SNAPSHOT=$snapshot_state
  ENVELOPE_MIGRATION_SNAPSHOT_DUMP=$snapshot_dump

  # 3) deterministic pack validation.
  compose_candidate "$release" "$attempt" run --rm --no-deps api \
    python scripts/production_pack.py validate --pack "$PACK" \
    >"$raw_dir/validate.raw" || validate_rc=$?

  # 4) model evidence against the real gateway (writes to throwaway db only).
  compose_candidate "$release" "$attempt" run --rm --no-deps api \
    python scripts/production_pack.py qualify --pack "$PACK" \
    >"$raw_dir/qualify.raw" || qualify_rc=$?

  extract_json_payload() {
    local raw=$1 out=$2
    awk 'BEGIN{found=0} /^\{/{found=1} found{print}' "$raw" >"$out"
    grep -q '"passed"' "$out" \
      || { echo "could not extract JSON payload from $raw" >&2; return 1; }
  }
  if ! extract_json_payload "$raw_dir/validate.raw" "$raw_dir/validate.json"; then
    validate_rc=1
  fi
  if ! extract_json_payload "$raw_dir/qualify.raw" "$raw_dir/qualify.json"; then
    qualify_rc=1
  fi

  # Digest binding: exact image ids of the per-attempt candidate tags.
  local svc tag id
  for svc in api worker web; do
    tag="novelforge-$svc:candidate-$attempt"
    id=$(app_image_digest "$tag") \
      || die 70 "candidate image $tag missing after build"
    digests="${digests}${digests:+|}$(printf '%s:%s' "$svc" "$id")"
  done
  ENVELOPE_IMAGE_DIGESTS=$digests

  local passed=true
  [ "$validate_rc" -eq 0 ] || passed=false
  [ "$qualify_rc" -eq 0 ] || passed=false
  [ "$snapshot_restore_rc" -eq 0 ] || passed=false
  [ "$snapshot_migrate_rc" -eq 0 ] || passed=false

  if [ "$passed" = "true" ]; then
    write_envelope "$sha" "$attempt" passed "$candidate_env_hash"
    CANDIDATE_PUBLISHED=true
  else
    write_envelope "$sha" "$attempt" failed "$candidate_env_hash"
  fi
  local envelope
  envelope=$(envelope_path "$sha")

  printf '{"ok":true,"action":"candidate","sha":"%s","attempt_id":"%s","passed":%s,"migrations":{"fresh":"passed","production_snapshot":"%s"},"validation":' \
    "$sha" "$attempt" "$passed" "$snapshot_state"
  cat "$raw_dir/validate.json"
  printf ',"model_evidence":'
  cat "$raw_dir/qualify.json"
  printf ',"envelope":"%s"}\n' "$envelope"

  [ "$passed" = "true" ] || exit 71
}

check_candidate_passed() {
  # Strict, multi-factor validation (P0-C fail-closed): parse the envelope
  # strictly, then check state, freshness, environment hash and the current
  # digests of the per-attempt candidate images.
  local sha=$1
  parse_envelope "$sha"

  [ "$ENV_STATE" = "passed" ] \
    || die 71 "candidate gate for $sha is state=$ENV_STATE (not passed); re-run 'candidate $sha'"

  local now
  now=$(date -u +%s)
  if [ "$ENV_CREATED" -gt "$now" ] \
    || [ "$ENV_CREATED" -le $((now - CANDIDATE_MAX_AGE_SECONDS)) ]; then
    die 71 "candidate gate result for $sha is stale (older than ${CANDIDATE_MAX_AGE_SECONDS}s); re-run 'candidate $sha'"
  fi

  local current_hash
  current_hash=$(env_file_hash)
  if [ "$ENV_HASH" != "$current_hash" ]; then
    die 71 "shared .env changed since candidate $sha (env_hash mismatch); re-run 'candidate $sha'"
  fi

  # The recorded digests must still be the current ids of this attempt's
  # candidate images (they are attempt-unique, so a mismatch means the tag
  # was re-pointed or the image was deleted after the gate).
  local svc recorded_id current_id tag
  for svc in api worker web; do
    case "$svc" in
      api) recorded_id=$ENV_DIGEST_API ;;
      worker) recorded_id=$ENV_DIGEST_WORKER ;;
      web) recorded_id=$ENV_DIGEST_WEB ;;
    esac
    tag="novelforge-$svc:candidate-$ENV_ATTEMPT_ID"
    current_id=$(app_image_digest "$tag") \
      || die 71 "image $tag missing; re-run 'candidate $sha'"
    if [ "$current_id" != "$recorded_id" ]; then
      die 71 "image $tag was re-pointed after the candidate gate (digest mismatch); re-run 'candidate $sha'"
    fi
  done
  return 0
}

publish_release_artifacts() { # $1=sha $2=attempt: tag candidate images as the release artifacts
  local sha=$1 attempt=$2 svc candidate_tag release_tag candidate_id published_id
  local deployed_sha
  deployed_sha=$(current_sha)
  for svc in api worker web; do
    candidate_tag="novelforge-$svc:candidate-$attempt"
    release_tag="novelforge-$svc:$sha"
    candidate_id=$(app_image_digest "$candidate_tag") \
      || die 71 "candidate image $candidate_tag vanished before publish"
    # A release SHA is immutable once deployed. Re-qualifying the current SHA
    # after an env rotation may reuse its artifact, but it must never replace
    # that tag with different bytes while the old container is still running.
    if [ "$sha" = "$deployed_sha" ]; then
      published_id=$(app_image_digest "$release_tag" 2>/dev/null || true)
      if [ -n "$published_id" ] && [ "$published_id" != "$candidate_id" ]; then
        die 71 "refusing to re-point deployed release tag $release_tag"
      fi
    fi
    docker tag "$candidate_tag" "$release_tag"
    published_id=$(app_image_digest "$release_tag") \
      || die 70 "release image $release_tag missing after publish"
    [ "$published_id" = "$candidate_id" ] \
      || die 70 "release tag $release_tag digest mismatch after publish"
  done
}

activate_app_services() { # $1=release; never starts/recreates postgres or redis
  compose "$1" up -d --no-deps api worker web
}

# ── backup / deploy / rollback ──────────────────────────────────────────────

deploy_sha() {
  local sha=$1
  local previous release backup attempt
  fetch_main
  validate_sha "$sha"
  release=$(prepare_release "$sha")
  previous=$(current_release)

  compose "$release" config --quiet

  # Hard gate BEFORE anything that could touch production state.
  check_candidate_passed "$sha"
  attempt=$ENV_ATTEMPT_ID

  # Controlled release-artifact publication: the gate-verified per-attempt
  # images are tagged as the release artifacts (§9.2). Nothing running is
  # touched by this step.
  publish_release_artifacts "$sha" "$attempt"

  backup_source=${previous:-$release}
  backup=$(backup_database "$backup_source" "$sha")

  # Migration as a one-off container (--no-deps: no service is ever started,
  # recreated or restarted by this call) against the production database.
  compose "$release" run --rm --no-deps api alembic upgrade head

  switch_to "$release"
  local activation_failed=false
  activate_app_services "$release" || activation_failed=true
  if [ "$activation_failed" = "true" ] || ! wait_healthy; then
    if [ "$activation_failed" = "true" ]; then
      echo "new release application activation failed" >&2
    else
      echo "new release failed health check" >&2
    fi
    if [ -n "$previous" ] && [ -d "$previous" ]; then
      switch_to "$previous"
      if activate_app_services "$previous" && wait_healthy; then
        printf '%s\n' '{"ok":false,"action":"deploy","rollback":"succeeded"}' >&2
      else
        printf '%s\n' '{"ok":false,"action":"deploy","rollback":"failed"}' >&2
      fi
    else
      printf '%s\n' '{"ok":false,"action":"deploy","rollback":"unavailable","reason":"no previous release"}' >&2
    fi
    exit 70
  fi
  install_release_controller "$release"
  printf '%s\n' "$sha" >"$SHARED/DEPLOYED_SHA"
  printf '{"ok":true,"action":"deploy","sha":"%s","previous":"%s","backup":"%s","candidate_attempt":"%s"}\n' \
    "$sha" "${previous##*/}" "${backup##*/}" "$attempt"
}

rollback_sha() {
  local sha=$1
  local release="$RELEASES/$sha"
  local previous
  fetch_main
  validate_sha "$sha"
  [ -d "$release" ] || die 66 "release not prepared: $sha"
  write_release_tag_file "$release"
  local svc
  for svc in api worker web; do
    app_image_digest "novelforge-$svc:$sha" >/dev/null \
      || die 66 "rollback image novelforge-$svc:$sha is missing"
  done
  previous=$(current_release)
  switch_to "$release"
  if ! activate_app_services "$release" || ! wait_healthy; then
    if [ -n "$previous" ] && [ -d "$previous" ]; then
      switch_to "$previous"
      activate_app_services "$previous" || true
    fi
    die 70 "rollback target failed activation or health check"
  fi
  printf '%s\n' "$sha" >"$SHARED/DEPLOYED_SHA"
  printf '{"ok":true,"action":"rollback","sha":"%s"}\n' "$sha"
}

# ── status ──────────────────────────────────────────────────────────────────

show_status() {
  local release sha health=false current_kind=absent
  release=$(current_release)
  sha=$(current_sha)
  if [ -n "$release" ]; then
    current_kind=managed
  elif [ -e "$CURRENT" ] || [ -L "$CURRENT" ]; then
    current_kind=legacy
  fi
  healthy && health=true || true

  local lines line svc rel image
  local prov_api="" prov_web="" prov_worker="" prov_postgres="" prov_redis=""
  local img_postgres="" img_redis=""
  local found="" unexpected="" missing="" invalid_provenance=""

  if [ -n "$release" ] && [ -d "$release/deploy" ]; then
    # Compose versions emit either one JSON object per line or a compact JSON
    # array. Normalize both representations before the deliberately minimal
    # field extraction below.
    lines=$(compose "$release" ps --format json 2>/dev/null \
      | sed -e 's/^[[:space:]]*\[//' -e 's/\][[:space:]]*$//' -e 's/},{/}\
{/g' || true)
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      svc=$(printf '%s' "$line" | sed -n 's/.*"Service":"\([a-z]*\)".*/\1/p')
      rel=$(printf '%s' "$line" | sed -n 's#.*com\.docker\.compose\.project\.working_dir='"$RELEASES"'/\([0-9a-f]\{40\}\)/deploy.*#\1#p')
      image=$(printf '%s' "$line" | sed -n 's/.*"Image":"\([^"]*\)".*/\1/p')
      case "$svc" in
        api) prov_api=$rel ;;
        web) prov_web=$rel ;;
        worker) prov_worker=$rel ;;
        postgres) prov_postgres=$rel; img_postgres=$image ;;
        redis) prov_redis=$rel; img_redis=$image ;;
        *) [ -n "$svc" ] && unexpected="$unexpected$svc " ;;
      esac
      [ -n "$svc" ] && found="$found $svc"
    done <<<"$lines"
  fi

  local svc
  for svc in $EXPECTED_SERVICES; do
    case " $found " in
      *" $svc "*)
        case "$svc" in
          api) [ -n "$prov_api" ] || invalid_provenance="$invalid_provenance$svc " ;;
          web) [ -n "$prov_web" ] || invalid_provenance="$invalid_provenance$svc " ;;
          worker) [ -n "$prov_worker" ] || invalid_provenance="$invalid_provenance$svc " ;;
          postgres) [ -n "$prov_postgres" ] || invalid_provenance="$invalid_provenance$svc " ;;
          redis) [ -n "$prov_redis" ] || invalid_provenance="$invalid_provenance$svc " ;;
        esac
        ;;
      *) missing="$missing$svc " ;;
    esac
  done

  # Plan A: only the three APP services decide mixed_release; postgres/redis
  # are reported as infra versions instead.
  local app_mixed=false
  if [ -n "$sha" ] \
    && { [ "$prov_api" != "$sha" ] || [ "$prov_web" != "$sha" ] || [ "$prov_worker" != "$sha" ]; }; then
    app_mixed=true
  fi

  local provenance_complete=false
  [ -z "$missing" ] && [ -z "$invalid_provenance" ] && provenance_complete=true

  json_value() {
    if [ -n "$1" ]; then printf '"%s"' "$1"; else printf 'null'; fi
  }
  json_array() { # words -> ["a","b"]
    local out="[" word first=true
    for word in $1; do
      if [ "$first" = "true" ]; then first=false; else out="$out,"; fi
      out="$out\"$word\""
    done
    printf '%s]' "$out"
  }

  printf '{"ok":true,"sha":"%s","health":%s,"release":"%s","current_kind":"%s","mixed_release":%s,"app_mixed_release":%s,"provenance_complete":%s,"missing_services":%s,"invalid_provenance_services":%s,"unexpected_services":%s,"infra_version":{"postgres":%s,"redis":%s},"provenance":{"api":%s,"web":%s,"worker":%s,"postgres":%s,"redis":%s}}\n' \
    "$sha" "$health" "$release" "$current_kind" "$app_mixed" "$app_mixed" \
    "$provenance_complete" \
    "$(json_array "$missing")" "$(json_array "$invalid_provenance")" \
    "$(json_array "$unexpected")" \
    "$(json_value "$img_postgres")" "$(json_value "$img_redis")" \
    "$(json_value "$prov_api")" "$(json_value "$prov_web")" \
    "$(json_value "$prov_worker")" "$(json_value "$prov_postgres")" \
    "$(json_value "$prov_redis")"
  if [ -n "$release" ] && [ -d "$release/deploy" ]; then
    compose "$release" ps --format json || true
  fi
}

show_logs() {
  local service=$1 lines=$2 release
  [[ $service =~ ^(web|api|worker|postgres|redis)$ ]] || exit 64
  [[ $lines =~ ^[0-9]+$ ]] && [ "$lines" -le 500 ] || exit 64
  release=$(current_release)
  [ -n "$release" ] || exit 69
  compose "$release" logs --no-color --tail "$lines" "$service"
}

novel_action() {
  local action=$1 release
  [[ $action =~ ^(validate|qualify|install|start|status|monitor|audit|export|download)$ ]] || exit 64
  release=$(current_release)
  [ -n "$release" ] || exit 69
  if [ "$action" = export ]; then
    compose "$release" exec -T api python scripts/production_pack.py export \
      --pack "$PACK" --output /app/data/exports/zhutian-hongyanlu.txt
  elif [ "$action" = download ]; then
    compose "$release" exec -T api python scripts/production_pack.py export \
      --pack "$PACK" --output /app/data/exports/zhutian-hongyanlu.txt >&2
    cat "$SHARED/data/exports/zhutian-hongyanlu.txt"
  else
    compose "$release" exec -T api python scripts/production_pack.py "$action" \
      --pack "$PACK"
  fi
}

self_heal() {
  local release
  release=$(current_release)
  [ -n "$release" ] || exit 0
  healthy && exit 0
  # `start` can resume existing infra containers but never recreates them.
  compose "$release" start postgres redis >/dev/null 2>&1 || true
  activate_app_services "$release"
  wait_healthy
}

# Test/sourcing hook: NOVELFORGE_CONTROLLER_SOURCABLE=1 stops before the
# dispatcher so tests can call compose_candidate()/compose() through the real
# controller code (never used in production).
if [ "${NOVELFORGE_CONTROLLER_SOURCABLE:-0}" = "1" ]; then
  # shellcheck disable=SC2317 # reached when the script is sourced by tests
  return 0 2>/dev/null || true
fi

case "${1:-status}" in
  status) [ "$#" -eq 1 ] && show_status ;;
  deploy) [ "$#" -eq 2 ] && deploy_sha "$2" ;;
  rollback) [ "$#" -eq 2 ] && rollback_sha "$2" ;;
  logs) [ "$#" -eq 3 ] && show_logs "$2" "$3" ;;
  candidate) [ "$#" -eq 2 ] && candidate_sha "$2" ;;
  novel) [ "$#" -eq 2 ] && novel_action "$2" ;;
  healthcheck) [ "$#" -eq 1 ] && self_heal ;;
  *) exit 64 ;;
esac
