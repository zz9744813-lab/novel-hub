Host novel-hub
    HostName 107.172.138.14
    Port 22022
    User novelops
    IdentityFile ~/.ssh/novelforge_ops
    IdentitiesOnly yes
    PreferredAuthentications publickey
    BatchMode yes
    ConnectTimeout 12
    ConnectionAttempts 3
    ServerAliveInterval 20
    ServerAliveCountMax 6
    TCPKeepAlive yes
    # Windows OpenSSH clients do not provide a dependable ControlMaster
    # socket. Each restricted command is short and the remote job owns its
    # resumability, so keep multiplexing disabled for the documented client.
    ControlMaster no
